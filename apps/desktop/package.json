{
  "name": "@kb-agent/desktop",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev": "pnpm rebuild:native && electron-vite dev",
    "build": "electron-vite build",
    "test": "pnpm rebuild better-sqlite3 && vitest run",
    "test:e2e": "pnpm rebuild:native && electron-vite build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kb-agent/core": "workspace:^",
    "@kb-agent/gateway": "workspace:^",
    "@kb-agent/model": "workspace:^",
    "@kb-agent/storage": "workspace:^",
    "@kb-agent/workspace": "workspace:^",
    "@napi-rs/canvas": "0.1.80",
    "better-sqlite3": "12.11.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sqlite-vec": "0.1.10-alpha.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.45.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
